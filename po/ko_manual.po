# ============================================================
# insight.c 조합 패턴 검토 요약 (enl_msg)
# ============================================================
#
# 포맷: enl_msg(prefix, present, past, suffix, ps)
# 영어:  " %s%s%s%s." = " [prefix][present/past][suffix][ps]."
# 한국어: " %1$s%3$s%2$s%4$s." = " [prefix][suffix][present/past][ps]."
#
# 번역 전략:
# 1. 동사(present/past)가 suffix에 포함된 경우: 동사를 "​"(제로폭 공백)로
# 2. suffix에 목적어만 있는 경우: 동사를 문장 끝에 오도록 suffix 뒤 공백 추가
# 3. prefix가 완전한 문장인 경우: 나머지를 "​"(제로폭 공백)로
#
# 주요 매크로 번역:
# - You_ = "당신은 "
# - are/were = "​" (suffix에 동사 포함 전략)
# - have/had = "​"
# - can/could = "​"
# - have_been/have_never/never = "​" 또는 ""
#
# 조합 예시:
# enl_msg(You_, "have gone", "went", " without food", "")
# → " 당신은 음식 없이 지냈다."
#
# enl_msg(You_, "could be", "could have been", " clairvoyant", buf)
# → " 당신은 천리안 능력자가 될 수 있었다 (원인)."
#
# enl_msg("You aggravate", "", "d", " monsters", from_what())
# → " 당신은 몬스터들을 자극한다 (원인)."
#
# ============================================================

# ============================================================
# 조합 패턴 전체 검토 결과 (2026-02-06)
# ============================================================
#
# 검토 대상: insight.c의 모든 enl_msg() 패턴 (65개)
# 검토 결과: 모든 주요 패턴이 번역됨
#
# [완료된 패턴 카테고리]
#
# 1. 기본 상태 패턴 (you_are, you_have, you_can)
#    - "are "/"were " → "​" (제로폭 공백)
#    - "have "/"had " → "​"
#    - "can "/"could " → "​"
#    - suffix에 완전한 술어 포함
#
# 2. 조건부 동사 패턴
#    - "will see"/"would have seen" + " invisible" → "투명한 것을 볼 것이다"
#    - "could be"/"could have been" + " clairvoyant" → "천리안 능력자가 될 수 있다"
#    - "would fly"/"would have flown" + conditions → "날 것이다"
#
# 3. 과거형 접미사 패턴
#    - "You aggravate" + ""/"d" + " monsters" → "몬스터들을 자극한다"
#    - "You cause" + ""/"d" + " conflict" → "분쟁을 일으킨다"
#    - "You regenerate" + ""/"d" → "재생한다"
#
# 4. 아이템 저항 패턴
#    - "Your items " + "are"/"were" + " somewhat%s" → "어느 정도 %s"
#    - " protected from fire/cold/acid/..." → "화염/냉기/산성에 대해 보호 상태"
#
# 5. 업적/행실 패턴
#    - "have"/"had" vs "have handled"/"handled" → 소유 vs 다룸 구분
#    - "have gone"/"went" + " without food" → "음식 없이 지냈다"
#    - "started"/"started out" + " without possessions" → "소유물 없이 시작했다"
#
# 6. 특수 접두어 패턴
#    - "Bad luck "/"Good luck " + "does"/"did" → 행운/불운 시간 경과
#    - "Your life " + "will be"/"would have been" + " saved" → "생명이 보존될 것이다"
#    - "Your alignment " + "is"/"was" → "성향은"
#
# ============================================================
# 다른 소스 파일의 조합 패턴 검토 결과
# ============================================================
#
# Tobjnam/Yobjnam 패턴:
#   - pline(_("%s %s."), Tobjnam(obj, _("verb")), ...) 형태
#   - Tobjnam()이 객체명+동사를 결합하므로 개별 동사 번역 필요
#   - "slip", "slam", "weld", "evaporate" 등 → ko.po에서 번역됨
#
# 삼항 연산자 패턴:
#   - condition ? _("option1") : _("option2")
#   - 한국어 문법에 맞게 각 옵션 개별 번역
#   - "tangy"/"sour", "cut"/"punch" 등 → ko.po에서 번역됨
#
# ============================================================
# Lua 파일 번역 추가
# ============================================================

