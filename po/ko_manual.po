msgid "small"
msgstr "약간의"

msgctxt "combat_mod"
msgid "moderate"
msgstr "상당한"

msgctxt "combat_mod"
msgid "large"
msgstr "큰"

msgctxt "combat_mod"
msgid "huge"
msgstr "막대한"

# combat_inc 컨텍스트 - 전투 유형 이름 (inctyp)
