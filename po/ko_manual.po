# --- 영어 복수형 접미사(plur()) 한국어 노출 일괄 수정 ---
# plur() 함수는 영어에서 "s" 또는 ""를 반환하여 복수형을 만듦.
# 한국어에는 이러한 접미사가 불필요하므로 %.0s로 억제함.

# ===== apply.c =====

# apply.c:1447 — 상점 주인 대사 "You burn/use them, you bought them!"
# %1$s = C_("shopkeeper","burn")="태우" / C_("shopkeeper","use")="사용하"
# %2$s = "them"/"it" (대명사 → 억제), %3$s = "them"/"it" (대명사 → 억제)
# 영어: "You burn them, you bought them!"
# 한국어: "태우면 산 것이다!" / "사용하면 산 것이다!"
#, c-format
msgid "You %s %s, you bought %s!"
msgstr "%2$.0s%3$.0s%1$s면 산 것이다!"

# apply.c:277 - 청진기 사망 확인
# %1$s=this/that/these/those → "이것"/"그것" (대명사 형태, 관형사로 부적합 → 억제)
# %2$s=""/"s" (복수 접미사 → 억제), %3$s=is/are (be동사 → 억제)
# %4$s=" mostly"/""→" 대부분"/""
# 영어 조합: "You determine that this unfortunate being is mostly dead."
# 한국어 조합: "그 불행한 존재가 대부분 죽었다고 판단한다."
#, c-format
