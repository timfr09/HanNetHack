# ============================================================
# ============================================================
# [조합 메시지] 동사 접두어 - insight.c:44-52
#
# 사용 위치: you_are(), you_have(), you_can() 등의 매크로
# 조합 구조: You_ + are/have/can + 동사/형용사 + suffix
#
# 영어 예: "You are swimming" → You_ + "are " + "swimming"
# 한국어: "당신은 수영 중" → "당신은 " + "" + "수영 중"
#
# 한국어는 동사가 문장 끝에 오므로 접두어가 불필요
# 제로 폭 공백 사용 (빈 문자열은 영어로 폴백됨!)
# ============================================================

# [조합] "can " - 조동사. 한국어에서는 동사 뒤에 붙음
msgid "can "
msgstr "​"

# [조합] "could " - 과거 조동사
