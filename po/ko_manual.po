# [조합 메시지] src/do_wear.c:3285 - 외피 갑옷 벗기 요청
# 조합 요소:
#   %1$s = 외피 갑옷 이름 (예: "your cloak")
#   %2$s = 동사 "dip" 또는 "grease"
#   %3$s = 대상 물건 이름 (예: "your shirt")
# 영어 조합: "You need to take off your cloak to dip your shirt."
# 한국어 조합: "망토를 벗어야 셔츠를 담글 수 있다."
# 주의: 어순 변경 필요 - %2$s(동사)와 %3$s(대상) 순서 바꿈
#, c-format
msgid "need to take off %s to %s %s."
msgstr "%1$s{을/를} 벗어야 %3$s{을/를} %2$s 수 있다."

# [조합 메시지] src/potion.c:2266 - 담그기 동사
# "need to take off %s to %s %s." 조합에서 사용
# 조합결과: "망토를 벗어야 셔츠를 담글 수 있다."
msgid "dip"
msgstr "담글"

# [조합 메시지] src/apply.c:2626 - 기름칠 동사
