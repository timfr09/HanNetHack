# ============================================================
# 어순 조정이 필요한 문장 패턴
# 한국어는 부사/위치가 동사 앞에 와야 자연스러움
# ============================================================

# monmove.c - 몬스터 이동 메시지
# 영어: "%s %s%s." = "The orc moves closer."
# 한국어 어순: "오크가 더 가까이 이동한다." (부사 + 동사)
# %1$s=몬스터, %2$s=동사, %3$s=위치부사
#, c-format
msgid "%s %s%s."
msgstr "%1$s{이/가}%3$s %2$s."

# makemon.c - 아이템/몬스터 출현 메시지
# 영어: "%s%s %s%s%c" = "Gold pieces appear next to you!"
# 한국어 어순: "금화가 당신 옆에 나타난다!" (위치 + 동사)
# %1$s=관사, %2$s=아이템, %3$s=동사, %4$s=위치, %5$c=문장부호
#, c-format
msgid "%s%s %s%s%c"
msgstr "%1$s%2$s{이/가}%4$s %3$s%5$c"

# insight.c:212 - 피해 유형. "의사"(doctor)가 아님!
# "half physical damage" = "물리 피해 절반"
msgid "physical"
msgstr "물리"
