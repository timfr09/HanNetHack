# [조합 메시지] end.c:1530 - 게임 종료 메시지 (승리/탈출)
# 조합 요소:
#   %1$s = death_verb - "passed away" 등 (동사)
#   %2$ld = u.urexp - 경험치 점수
#   %3$s = plur(u.urexp) - 영어 복수형 "s"/"" (한국어 불필요)
# 영어 조합: "You passed away beyond the confines of the dungeon with 12345
# points,"
# 한국어 조합: "당신은 12345점을 가지고 던전의 경계를 넘어 세상을 떠났다,"
#: ../src/end.c:1528
#, c-format
msgid "You %1$s beyond the confines of the dungeon with %2$ld point%3$s,"
msgstr "당신은 %2$ld점을 가지고 던전의 경계를 넘어 %1$s,%3$.0s"

# 예: "You died in The Dungeons of Doom on dungeon level 5 with 1000 points,"
# 한국어: "파멸의 던전 5층에서 죽었다. 1000점,"
