# trap.c:4607 — 물약 효과 (이미 ko_manual.po에 있으므로 생략)

# === Category 4: 문체 불일치 수정 (-ㅂ니다 → -다 체) ===

# lock.c:1175 — 문이 닫히며 잠김
msgid "The door swings shut, and locks!"
msgstr "문이 닫히면서 잠긴다!"

# lock.c:1178 — 부서진 문 재조립
msgid "The broken door reassembles and locks!"
msgstr "부서진 문이 재조립되어 잠긴다!"

# lock.c:1182 — 먼지 구름이 문으로
msgid "A cloud of dust springs up and assembles itself into a door!"
msgstr "먼지 구름이 일어나 문으로 모인다!"

# engrave.c:603 — 지팡이 저항
msgid "The wand unsuccessfully fights your attempt to write!"
msgstr "지팡이가 당신의 쓰기 시도를 막으려 하지만 실패한다!"

# === Category 6: 골드 → 금화 + 복수접미사 억제 ===

# shk.c:4073 — 상점주인 제안
#, c-format
msgid "%s offers%s %ld gold piece%s for %s%s "
msgstr "%1$s{이/가}%2$s %5$s%6$s에 대해 금화 %3$ld개%4$.0s{을/를} 제안한다 "

