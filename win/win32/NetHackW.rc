IDI_NETHACKW            ICON                    "NETHACK.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_NETHACKW MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "저장 후 종료(&S)",            IDM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "종료(&Q)",                    IDM_EXIT
    END
    POPUP "지도(&M)"
    BEGIN
        MENUITEM "&0 - 타일 사용",              IDM_MAP_TILES
        MENUITEM "&1 - ASCII (4x6)",            IDM_MAP_ASCII4X6
        MENUITEM "&2 - ASCII (6x8)",            IDM_MAP_ASCII6X8
        MENUITEM "&3 - ASCII (8x8)",            IDM_MAP_ASCII8X8
        MENUITEM "&4 - ASCII (16x8)",           IDM_MAP_ASCII16X8
        MENUITEM "&5 - ASCII (7x12)",           IDM_MAP_ASCII7X12
        MENUITEM "&6 - ASCII  (8x12)",          IDM_MAP_ASCII8X12
        MENUITEM "&7 - ASCII (16x12)",          IDM_MAP_ASCII16X12
        MENUITEM "&8 - ASCII (12x16)",          IDM_MAP_ASCII12X16
        MENUITEM "&9 - ASCII  (10x18)",         IDM_MAP_ASCII10X18
        MENUITEM SEPARATOR
        MENUITEM "화면에 맞추기(&F)",           IDM_MAP_FIT_TO_SCREEN
        MENUITEM SEPARATOR
        MENUITEM "클립보드에 복사(&C) (ASCII)", IDM_SETTING_SCREEN_TO_CLIPBOARD
        MENUITEM "파일로 저장(&S) (ASCII)",     IDM_SETTING_SCREEN_TO_FILE
    END
    POPUP "창 설정(&S)"
    BEGIN
        MENUITEM "넷핵 모드",                   IDM_NHMODE
        MENUITEM SEPARATOR
        MENUITEM "모든 설정 초기화(&C)",        IDM_CLEARSETTINGS
        MENUITEM SEPARATOR
        MENUITEM "자동 창 배치(&A)",            IDM_SETTING_AUTOLAYOUT
        MENUITEM "창 잠금(&L)",                 IDM_SETTING_LOCKWINDOWS
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "정보(&A)...",                 IDM_ABOUT
        MENUITEM "게임 상세 설명(&G)",          IDM_HELP_LONG
        MENUITEM "명령어 목록(&C)",             IDM_HELP_COMMANDS
        MENUITEM "넷핵의 역사(&H)",             IDM_HELP_HISTORY
        MENUITEM "화면 문자 정보(&I)",          IDM_HELP_INFO_CHAR
        MENUITEM "키 기능 정보(&K)",            IDM_HELP_INFO_KEY
        MENUITEM "게임 옵션 목록(&O)",          IDM_HELP_OPTIONS
        MENUITEM "게임 옵션 상세 목록(&L)",     IDM_HELP_OPTIONS_LONG
        MENUITEM "확장 명령어 목록(&X)",        IDM_HELP_EXTCMD
        MENUITEM "넷핵 라이선스(&N)",           IDM_HELP_LICENSE
        MENUITEM "Windows용 넷핵 도움말(&W)",   IDM_HELP_PORTHELP
    END
END


