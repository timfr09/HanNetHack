# potion.c:1549, wield.c:910 - 성수/저수 담그기 또는 주문 효과로 아이템 빛남(아우라)
# %1$s=Yobjnam2(obj, "glow")="[당신의 물건] 빛나다", %2$s=an(hcolor)="[색상]"
# [리뷰 완료] potion.c:1549+wield.c:910 — Yobjnam2(glow)/aobjnam(glow)+hcolor
# %1$s = objphrase (Yobjnam2 또는 aobjnam 결과), %2$s = an(glowcolor) = 색상
# Yobjnam2 경우: %1$s = "검{이/가} 빛나다" (glow 사전형 — Known Issue)
# 안장 경우: %1$s = "안장{이/가}" (C_("Tobjnam","glow") 계사 억제)
# 안장 경우 동사 누락 해결: 포맷에 "빛났다" 제공
# 영어: "Your sword glows with an amber aura."
# 한국어: "검이 빛나다 호박색 아우라를 내뿜었다." (Yobjnam2, glow 사전형 잔여)
# 한국어: "안장이 호박색 아우라를 내뿜었다." (안장, 계사 억제 + 포맷 동사)
#, c-format
msgid "%s with %s aura."
msgstr "%1$s %2$s 아우라를 내뿜었다."

# pray.c:1194 - 기도 응답으로 무기 축복 + 수리
# %1$s=Yobjnam2(uwep, "softly glow"), %2$s=an(hcolor), %3$s=repair_buf
# repair_buf = "" (수리 불필요) 또는 ", 그리고 이제 새것처럼 좋아졌다" (수리 완료)
# 영어 조합: "Your long sword softly glows with a light blue aura and is now as good as new."
# 한국어 조합: "밝은 파란색 아우라와 함께 당신의 장검 은은하게 빛난다, 그리고 이제 새것처럼 좋아졌다."
# 주의: %3$s가 빈 문자열이면 마침표로 종료
#, c-format
msgid "%s with %s aura%s."
msgstr "%2$s 아우라와 함께 %1$s%3$s."

# pray.c:1178 - 무기 수리 추가 메시지 (repair_buf)
# %s=otense(uwep, "are")="이다" → 한국어에서 be동사 불필요, 억제
# 영어 조합: " and are now as good as new"
# 한국어 조합: ", 그리고 이제 새것처럼 좋아졌다"
# ko.po "%s{이/가} 새것처럼 좋다!"는 "이다가 새것처럼 좋다!"가 되어 비문
# 부모 포맷에 마침표가 있으므로 자체 구두점 제거
#, c-format
msgid " and %s now as good as new"
msgstr ", 그리고 이제 새것처럼 좋아졌다%.0s"

