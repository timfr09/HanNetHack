#, c-format
msgid "As %s %s inside, you are blasted by a magical explosion!"
msgstr "%1$s{이/가} 안으로 굴러 들어가자, 마법 폭발에 휩싸였다!%2$.0s"

# [리뷰 완료] uhitm.c:5371 — vtense(knock) 밀쳐내기
# %1$s = magrbuf (공격자), %2$s = vtense(knock) (억제)
# %3$s = mdefbuf (방어자), %4$s = knockedhow (뒤로)
# %5$s = "forceful"/"powerful", %6$s = "blow"/"strike"
# 영어: "You knock the gnome back with a powerful blow!"
# 한국어: "당신이 강력한 일격으로 노움을 뒤로 밀쳐냈다!"
#, c-format
msgid "%s %s %s %s with a %s %s!"
msgstr "%1$s{이/가} %5$s %6$s{으로/로} %3$s{을/를} %4$s 밀쳐냈다!%2$.0s"

# [리뷰 완료] weapon.c:460 — Your()+vtense(sear)+mon_nam, 은반지 화상
# %1$s = "silver "/"left "/"right "/"", %2$s = rings = "반지/반지들"
# %3$s = vtense(sear) = "지졌다", %4$s = mon_nam(mdef)
