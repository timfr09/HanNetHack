# uhitm.c:2052 - 기름칠된/미끄러운 장비에서 미끄러지는 메시지
# %1=slip off of / grab but cannot hold onto
# %2=s_suffix(mon_nam) = "오크의"
# %3=greased/slippery = "기름칠된"/"미끄러운"
# %4=xname(obj) = "망토"
# 영어: "You slip off of the orc's greased cloak!"
# 한국어: "오크의 기름칠된 망토에서 미끄러졌다!"
# 주의: slip off of = "에서 미끄러졌다" 이므로 패턴에서 {에서} 불필요
#, c-format
msgid "%s %s %s %s!"
msgstr "%2$s %3$s %4$s %1$s!"

msgid "greased"
msgstr "기름칠된"

msgid "slippery"
msgstr "미끄러운"

