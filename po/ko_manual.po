msgstr " (경험으로 획득)"

# 수인화(lycanthropy)로 인한 효과
msgid " due to your lycanthropy"
msgstr " (수인화의 영향)"

# 변신 형태로 인한 효과
msgid " from your creature form"
msgstr " (현재 형태의 영향)"

msgid "The artifact"
msgstr "그 아티팩트"

msgid " for travel destination"
msgstr " 이동 목적지용"

msgid "Using"
msgstr "사용 중"

