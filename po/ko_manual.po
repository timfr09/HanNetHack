# ============================================================
# 사전형 동사 수정 — 보류/잔여 사항
# ============================================================
# 
# [보류] dokick.c:1932 " %s %s object%s" — Sprintf 조각 (hit는 이미 과거형)
# [보류] dokick.c:1935 " %s your chain" — Sprintf 조각 (rattle 활용형 전환 완료)
# [보류] dokick.c:1940 " and %s %s." — Sprintf 조각 (fall 활용형 전환 완료)
# [보류] uhitm.c:1678 "Your %s%s %s" — strNsubst+" %s!" 리터럴 추가로 어순 재배치 불가
# [보류] monmove.c:41 vtense(move) — "%s %s%s." 46파일 공유, 포맷 오버라이드 불가
# [보류] muse.c:3106 vtense(move) — locomotion() 변동 동사 (float/fly/slither 등)
# [보류] dogmove.c:1301 vtense(step) — step 활용형 전환 완료, locomotion 변종은 잔여
# [보류] timeout.c:1266 vtense(slide) — slide 활용형 전환 완료, locomotion 변종은 잔여
# ============================================================
# Known Issues 수정 (invent.c fbuf, potion.c get/wrinkled)
# ============================================================
# [리뷰 완료] invent.c:4153 — 삼킨 몬스터 소지품 목록 헤더
# 기존 "Contents of %s %s" 에서 %s %s 분리 → 단일 %s로 변경
# (fbuf[12] 하드코딩 제거를 위한 소스 수정 동반)
#: ../src/invent.c:4159
#, c-format
msgid "Contents of %s"
msgstr "%s의 내용물"

