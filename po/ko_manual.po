# ============================================================
# 
# [Lua 파일] - 총 330개+
# 
# quest.lua: 274개 (text= 86개 + synopsis= 188개)
#   - 퀘스트 대화/설명 텍스트
#   - 포맷 플레이스홀더: %l(leader), %p(player), %n(nemesis), %o(artifact)
#   - extract_lua_strings.py로 POT에 추출됨
#   - 예: "You again sense %l pleading for help."
# 
# tut-1.lua: 47개 text= 문자열
#   - 튜토리얼 각인 메시지
#   - 동적 키 연결: .. tut_key("jump") 형태
#   - 런타임 변수 포함으로 래핑 복잡
#   - 예: "Move around with " .. movekeys
# 
# tut-2.lua: 1개
#   - "Use '" .. nh.eckey("up") .. "' to go up the stairs"
# 
# 기타 Lua: soko*.lua, castle.lua, Mon-loca.lua, Arc-loca.lua
#   - "Elbereth" (고유명사, 번역 불필요)
#   - "X marks the spot." (번역 완료)
# 
# [헤더 파일] - 총 150개+
# 
# include/defsym.h: 115개 PCHAR/PCHAR2 매크로
#   - 지형/심볼 설명 ("vertical wall", "iron bars", "tree" 등)
#   - 매크로 구조상 N_() 래핑 필요
#   - 게임 내 look 명령(;)에서 표시됨
#   - 예: PCHAR(17, '#', S_bars, "iron bars", HI_METAL)
# 
# include/artilist.h: 36개 아티팩트명
#   - "Excalibur", "Mjollnir", "Stormbringer" 등
#   - 고유명사로 번역 불필요 (음차 가능)
# 
# [C 소스 파일]
# 
# 대부분 래핑 완료, 아래는 미래핑:
# 
# ★ 사용자 대면 (래핑 권장):
#   - src/mthrowu.c:24-28 breathwep[] - 브레스 무기 유형
#     "fragments", "fire", "frost", "sleep gas", "disintegration blast",
#     "lightning", "poison gas", "acid"
#     → 드래곤 브레스 메시지에서 표시됨
# 
#   - src/music.c:494-497 beats[] - 드럼 박자 유형
#     "stepper", "one drop", "slow two", "triple stroke roll",
#     "double shuffle", "half-time shuffle", "second line", "train"
#     → 드럼 연주 시 표시됨
# 
# ★ 개발자/디버그용 (래핑 불필요):
#   - src/glyphs.c:1014 altar_text[] - "unaligned", "chaotic", "neutral"
#   - src/glyphs.c:1032 zap_texts[] - "missile", "fire", "frost", "sleep"
#   - src/glyphs.c:1049 swallow_texts[] - "top left", "top center", etc.
#   - src/glyphs.c:1065 expl_type_texts[] - "dark", "noxious", "muddy"
