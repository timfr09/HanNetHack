# 한국어: "등불이 훨씬 더 밝게 빛났다."
#, c-format
msgid "%s %s %s%s."
msgstr "%1$s{이/가} %3$s%4$s 빛났다.%2$.0s"

# [리뷰 완료] pickup.c:3762 — doname+otense(tumble), 가방 폭발
# %1$s = doname(otmp), %2$s = otense(tumble) (억제)
# 영어: "As the bag tumbles inside, you are blasted by a magical explosion!"
