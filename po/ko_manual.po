# %s = Yobjnam2(uwep, "suddenly vibrate") = "당신의 검{이/가} 갑자기 진동했다"
# 고유 포맷 (1건) — PO 오버라이드 안전
# 영어: "Your sword suddenly vibrates unexpectedly."
# 한국어: "예기치 않게 당신의 검이 갑자기 진동했다."
#, c-format
msgid "%s unexpectedly."
msgstr "예기치 않게 %s."

# [리뷰 완료] wield.c:993 — Yobjnam2+glow/violently glow + color + time
# %1$s = Yobjnam2(uwep, "glow"/"violently glow") = "당신의 검{이/가} 빛나다/격렬하게 빛났다"
# %2$s = color, %3$s = "잠깐"/"한동안"
# 고유 포맷 (1건) — PO 오버라이드 안전
# 영어: "Your sword glows red for a moment."
# 한국어: "당신의 검이 빛나다 빨간 잠깐." → "잠깐 빨간 빛으로 당신의 검이 빛났다."
# 주의: %1$s에 동사 포함 → %2$s(색상)의 위치 조정만 가능
#, c-format
msgid "%s %s for a %s."
msgstr "%3$s %2$s %1$s."

# [리뷰 완료] wield.c:982 — Yobjnam2+violently glow + color + otense+evaporate
# %1$s = Yobjnam2(uwep, "violently glow") = "당신의 검{이/가} 격렬하게 빛났다"
# %2$s = color, %3$s = otense(uwep, "evaporate") = "증발했다"
# 고유 포맷 (1건) — PO 오버라이드 안전
# 영어: "Your sword violently glows red for a while and then evaporates."
# 한국어: "한동안 빨간 빛으로 당신의 검이 격렬하게 빛났다, 그러더니 증발했다."
#, c-format
msgid "%s %s for a while and then %s."
msgstr "한동안 %2$s %1$s, 그러더니 %3$s."

# [리뷰 완료] read.c:1181 — Yname2 + otense+vibrate/glow + hcolor + otense+evaporate
# %1$s = Yname2(otmp), %2$s = otense("vibrate"/"glow") = "진동했다"/"빛나다"
# %3$s = " " 또는 "", %4$s = hcolor 또는 "", %5$s = otense("evaporate") = "증발했다"
# 고유 포맷 (1건) — PO 오버라이드 안전
# 영어: "Your armor violently glows silver for a while, then evaporates."
# 한국어: "당신의 갑옷이 격렬하게 은색으로 진동하다가 증발했다."
#, c-format
msgid "%s violently %s%s%s for a while, then %s."
msgstr "%1$s{이/가} 격렬하게 %4$s%3$s%2$s 한동안, 그러더니 %5$s."

# [리뷰 완료] read.c:1246 — Yname2 + violently + otense+vibrate/glow + hcolor + time
# %1$s = Yname2(otmp), %2$s = "violently " 또는 ""
# %3$s = otense("vibrate"/"glow"), %4$s = " " 또는 ""
# %5$s = hcolor 또는 "", %6$s = "잠깐"/"한동안"
# 고유 포맷 (1건) — PO 오버라이드 안전
# 영어: "Your armor violently glows silver for a while."
# 한국어 (Blind): "한동안 당신의 갑옷이 격렬하게 진동했다."
# 한국어 (Sighted): "한동안 당신의 갑옷이 격렬하게 은색으로 빛나다."
# 주의: glow 사전형("빛나다") 잔여 — Known Issue
#, c-format
msgid "%s %s%s%s%s for a %s."
msgstr "%6$s %1$s{이/가} %2$s%5$s%4$s%3$s."

# ============================================================
# 조합 패턴 전수 검토 결과 (2026-02-14)
# ============================================================
#
# === 계사 억제 ("이다") — PO-only (Tobjnam 전용 동사) ===
# [OK] slip: 계사 억제 → Oops/throw/wield 포맷에서 직접 동사 제공
# [OK] weld: 계사 억제 → wield.c/weapon.c 포맷에서 "녹아붙었다" 제공
# [OK] evade: 계사 억제 → artifact.c/wield.c 포맷에서 "벗어났다" 제공
# [OK] burst: 계사 억제 → trap.c 포맷에서 "타올랐다" 제공
# [OK] slam: 계사 억제 → spell.c 포맷에서 "닫혔다" 제공
# [OK] fit: 계사 억제 → do_wear.c 포맷에서 "단단하다" 제공
# [OK] become: 계사 억제 → dig.c 포맷에서 "얽혔다" 제공
# [OK] assault: 계사 억제 → detect.c 포맷에서 "공격했다" 제공
# [OK] issue: 계사 억제 → apply.c 포맷에서 "소리를 냈다" 제공
# [OK] radiate: 계사 억제 → apply.c 포맷에서 "발산한다" 제공
# [OK] return: 계사 억제 → dothrow/mthrowu 포맷에서 "돌아왔다" 제공
#
# === C_() 컨텍스트 분리 패턴 ===
# [OK] C_("light", stop/begin/shine): 빛 시작/멈춤 동사 (wield/do_wear/worn/weapon)
# [OK] C_("autocurse", glow): 던바스캡 자동저주 (do_wear.c)
# [OK] C_("auxiliary", have): 조동사 have (apply.c 인형 파괴)
# [OK] C_("Tobjnam", seem): 보이다/같다 (apply.c/uhitm.c)
# [OK] C_("Tobjnam", look): 보이다/광택 (apply.c 시험석)
# [OK] C_("Tobjnam", damage): 피해를 주다 (detect.c)
# [OK] C_("Tobjnam", fail): 실패 (dothrow.c 부메랑)
# [OK] C_("Tobjnam", tumble): 굴러 떨어지다 (do.c 구덩이)
# [OK] C_("Tobjnam", fall): 떨어지다 (artifact.c 아이템 낙하)
# [OK] C_("Tobjnam", confuse): 혼란시키다 (detect.c 수정구)
# [OK] C_("Tobjnam", zap): 공격하다 (detect.c 수정구)
# [OK] C_("Tobjnam", vanish): 사라지다 (dothrow.c 삼킨 몬스터)
# [OK] C_("Tobjnam", hit): 맞히다 (dothrow.c 부메랑)
# [OK] C_("Tobjnam", fly): 날다 (dothrow.c/mthrowu.c 부메랑)
# [OK] C_("crystal_ball", "%s you!"): 수정구 혼란 포맷 분리
#
# === C_("Tobjnam") 이중 사용 동사 (2차 → 3차 수정) ===
# [OK] C_("Tobjnam", vibrate): "이다"→"진동했다" 활용형 전환 (3차)
# [OK] C_("Tobjnam", evaporate): "이다"→"증발했다" 활용형 전환 (3차)
# [OK] C_("Tobjnam", trill/toot): C_("music") 포맷 컨텍스트로 분리 (3차)
# [OK] C_("Tobjnam", go): 계사 억제 → 포맷에서 "꺼졌다" 제공
# [OK] C_("Tobjnam", break): 계사 억제 → 포맷에서 "부서졌다" 제공
# [OK] C_("Tobjnam", trigger): 계사 억제 → 포맷에서 "작동시켰다" 제공
# [OK] C_("Tobjnam", fade): "이다"→"바랬다" 활용형 전환 (3차)
# [OK] C_("Tobjnam", glow): 계사 억제 유지 → 포맷에서 동사 제공
#
# === PO-only 활용형 수정 — Tobjnam 전용 동사 (2차 수정) ===
# [OK] implode: "내파하다"→"내파했다" (detect.c 수정구)
# [OK] stop(bare): "멈추다"→"멈췄다" (dog.c 조각상)
# [OK] whisper: "속삭이다"→"속삭인다" (artifact.c 아티팩트)
# [OK] crumble: "부서지다"→"부서졌다" (explode.c 석상)
# [OK] misfire: "오발"→"오발했다" (dothrow.c 발사 오류)
# [OK] heat: 계사 억제 + 포맷에서 "뜨거워졌다" 제공 (do.c 뜨거운 땅)
# [OK] produce: 계사 억제 + 포맷에서 "연주했다" 제공 (music.c 하프)
#
# === 포맷 수정 (2차) ===
# [OK] "%s your %s!": 이중 {이/가} 제거 (dothrow.c Blind 부메랑)
# [OK] "%s apart.": "떨어졌다"→"산산이 부서졌다" (explode.c 바위)
# [OK] "%s out!"/"out.": "가다 나갔다"→"꺼졌다" (read.c/steal.c 소등)
# [OK] "%s, then %s.": 빛남+바래짐 통합 번역 (engrave.c)
# [OK] "%s with a strange light!": "빛나다 함께"→"빛으로 빛났다" (apply.c)
#
# === Yobjnam2 고유 포맷 오버라이드 (3차 수정) ===
# [OK] "%s briefly.": 어순 교정 "잠깐 %s." (read.c 충전)
# [OK] "%s%s%s for a moment.": 어순 교정 (read.c p_glow2)
# [OK] "%s feebly%s%s for a moment.": 어순 교정 (read.c p_glow3)
# [OK] "%s momentarily, then %s!": 폭발 고정 번역 (read.c 반지)
# [OK] "%s unexpectedly.": 어순 교정 (wield.c 엘프무기)
# [OK] "%s %s for a %s.": 어순 교정 (wield.c 인챈트)
# [OK] "%s %s for a while and then %s.": 어순 교정 (wield.c 과인챈트)
# [OK] "%s violently %s%s%s for a while, then %s.": 어순 교정 (read.c 과인챈트)
# [OK] "%s %s%s%s%s for a %s.": 어순 교정 (read.c 갑옷 인챈트)
#
# === 사전형→활용형 전환 (3차 수정) ===
# [OK] bare "vibrate": "진동하다"→"진동했다" (read.c Yobjnam2/otense)
# [OK] bare "evaporate": "증발하다"→"증발했다" (wield.c Yobjnam2/otense)
# [OK] bare "fade": "바래다"→"바랬다" (trap.c vtense)
# [OK] bare "pulsate": "맥동하다"→"맥동했다" (read.c Yobjnam2)
# [OK] "violently glow": "격렬하게 빛나다"→"격렬하게 빛났다"
# [OK] "faintly glow": "빛나기 시작한다"→"희미하게 빛났다" (오역 수정)
# [OK] "suddenly vibrate": "떨리는 진동."→"갑자기 진동했다" (오역 수정)
#
# === 기존 패턴 확인 ===
# [OK] feel 피동: {이/가} 삽입으로 주격조사 누락 해결
# [OK] 색상+glow: 기존 %.0s 억제 패턴 유지
# [OK] "%s %s for a moment." 공유 msgid: C_("autocurse")로 분리
# [OK] world spins: %2$s%1$s 역순으로 정상
# [OK] neighborhood: C_("neighborhood") 컨텍스트 정상
# [OK] 석화/소멸/변신: {이/가} 조사 정상
# [OK] music tumblers/gears: %.0s 복수형 억제 정상
# [OK] grease slip off: 어순 재배치 정상
# [OK] stagger for a moment: 고정 과거형 "비틀거렸다" 사용 (%2$s 억제)
# [OK] candelabrum dimly: 고정 문장 "%1$s/%2$s 모두 억제"
# [OK] arti_light_description: _() 래핑 + 5개 부사 번역 추가
# [OK] dominant right/left: "오른손잡이"→"오른 ", "왼손잡이"→"왼 " 수정
# [OK] worn.c:985 "%s %s shining %s.": %2$s(are="이다") 억제, {이/가} 포맷 삽입
# [OK] trap.c:1634 "%s you!": 물줄기 맞힘 동사 제공
# [OK] 부메랑 귀환/타격: return/hit/fly 계사 억제 + 포맷에서 동사 제공
#
# [Known Issues — low priority]
# - _("burn") transitive/intransitive 충돌
# [해결됨] mhitu.c:2570 → C_("stun") 컨텍스트 추가
# [해결됨] stagger 사전형→현재형 + "%s %s..." 충돌 → C_("stun")/C_("gaze") 분리
# - potion.c:1712 aobjnam+glow saddle: 동적 Snprintf 결합 (동사 누락)
# [해결됨] "resist" sit.c → C_("Tobjnam", "resist") 컨텍스트 추가
# - "shatter" 이중 사용 (Yobjnam2+otense, 해당 포맷에 고정 동사)
# - "flicker" 이중 사용 (Tobjnam+vtense, 해당 포맷에 ko_manual 조합)
#
# [해결됨] invent.c fbuf[12] → mon_stomach 분리로 UTF-8 안전하게 수정
# [해결됨] potion.c:1720 aobjnam(saddle, "get") → _("get") 래핑
# [해결됨] potion.c:2590 wrinkled/hcolor → C_("condition") 분리
# [해결됨] "%s with %s aura." 동사 누락 → "아우라를 내뿜었다" 제공
# [해결됨] steal.c "your" / steed.c "new" / do_wear.c "dust+falls" → 실제 이슈 아님
# [해결됨] light.c ConcatF1 → 현재 코드에서 찾을 수 없음
#
# [Known Issues — Yobjnam2 glow 사전형 (3차)]
# - "%s %s." 46건 공유: Yobjnam2+glow 사전형 잔여
#   (sit.c:625, apply.c:4317, read.c:1539, wield.c:975, pray.c:595/1298)
# - "%s." 49건 공유: Yobjnam2+vibrate at read.c:1339, Yobjnam2+evaporate at wield.c:986
#   (활용형 전환으로 동사는 있으나 공유 포맷이라 별도 오버라이드 불가)
# - bare "glow" 사전형 "빛나다": 명사/동사 이중 사용으로 활용형 전환 불가
# - "%s with %s aura." 2건 공유 (potion.c:1549+wield.c:910): 동사 누락

