#: src/mon.c:3382 - monkilled message
# 조합 요소:
#   %1$s = Monnam(mdef) - 몬스터 이름 (예: "The orc")
#   %2$s = "killed" 또는 "destroyed" - 사망 동사
#   %3$s = " by the " 또는 "" - 원인 연결사
#   %4$s = fltxt - 사망 원인 (예: "fire")
# 영어 조합: "The orc is killed by the fire!"
# 한국어 조합: "오크가 불에 의해 죽었다!"
#, c-format
msgid "%s is %s%s%s!"
msgstr "%1$s{이/가} %4$s%3$s%2$s!"

# [조합 메시지] src/mon.c:3384 - "by the" 연결사 (사망 원인)
# 영어: " by the fire" → 한국어: "불에 의해 " (어순 변경으로 앞에 옴)
msgid " by the "
msgstr "에 의해 "

