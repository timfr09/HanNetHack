# ============================================================
# 조합 패턴 전수 리뷰 (2026-02-22)
# ============================================================
#
# === 수정 완료 (이번 리뷰에서 발견/수정) ===
# [FIX] muse.c:297 "%s drinks %s!" — 동사 "마셨다" 누락
# [FIX] dokick.c:309 "%s harmlessly %s %s." — SVO 어순
# [FIX] zap.c:4798 "%s rips into %s%s" — {을/를} 느낌표에 붙음
# [FIX] read.c:1895 "%s of boulders %s %s you!" — 문장 부서짐
# [FIX] pray.c:1409 "%s potion%s...glow%s %s..." — 동사접미 미억제
# [FIX] wield.c:766 "%s %s suitable %s weapon%s." — aren't/plur 미처리
# [FIX] pray.c:802 "%s %s %s your %s!" — 어순 재배열
# [FIX] dothrow.c:1285 "%s %s the %s, then falls..." — 동사 위치
# [FIX] dothrow.c:2643 "%s shatter%s%s!" — 산산조각 이중 + 복수접미 미억제
# [FIX] zap.c:3956 "%s %s over %s." — SVO 어순
# [FIX] uhitm.c:1288 "%s %s over %s!" — SVO 어순
#
# === 확인 완료 (기존 번역 정상) ===
# [OK] steal.c:192 "%s steals %s!" → SOV 어순 정상
# [OK] steal.c:806 "%s absorbs %s!" → SOV 어순 정상
# [OK] dothrow.c:2098 "%s catches %s." → SOV 어순 정상
# [OK] dothrow.c:1816 "%s snatches up %s." → SOV 어순 정상
# [OK] muse.c:187 "%s zaps %s!" → SOV 어순 정상
# [OK] muse.c:842 "%s plays %s!" → SOV 어순 정상
# [OK] steal.c:798 "%s %s pulled from..." → SOV 정상
# [OK] wield.c:813 "%s spasms and drops %s!" → SOV 정상
# [OK] trap.c:6107 "%s released from %s%s." → SOV 정상
# [OK] trap.c:1518 "%s bear trap closes on %s %s!" → 정상
# [OK] potion.c:2621 "%s forms a coating on %s." → 정상
#
# === Known Issues (구조적 한계, 이번 리뷰에서 확인) ===
# - pray.c:1409 %1 = "The"/"Some of the"/"One of the": 한국어 관사 매핑 어색
#   ("그"/"일부의"/"중 하나의" → "제단의 그 물약" 등)
#   → 소스에서 분리하거나 C_() 컨텍스트 필요, 현재는 수용 가능 수준
# [해결됨] dothrow.c:640 → C_("hitfloor") 컨텍스트 추가
# [해결됨] zap.c:3556/3563 → C_("hit")/C_("miss") 컨텍스트 추가
# [해결됨] apply.c:1555 → 3 pline 분기 + C_("lantern") 컨텍스트
# [해결됨] apply.c:1684 → Blind 분기 + C_("candle") 컨텍스트
#
# ============================================================

# dothrow.c:640 — 물체가 바닥/표면을 맞힘
# %1$s=Doname2(obj), %2$s=verb(land/step/fall/hit 등), %3$s=surface
# 영어: "The potion hits the floor." → "물약이 바닥을 맞혔다."
#, c-format
msgctxt "hitfloor"
msgid "%s %s the %s."
msgstr "%1$s{이/가} %3$s{을/를} %2$s."

# do.c:1280 — 플레이어가 구멍/함정문으로 내려감
# %1$s=actn(jump/crawl 등), %2$s=down/through, %3$s=hole/trap door
# 영어: "You jump through the trap door." → "함정문을 통해 뛰어내렸다."
#, c-format
msgctxt "dodown"
msgid "%s %s the %s."
msgstr "%3$s %2$s %1$s."

# apply.c:1555 — 랜턴이 탁탁거리며 깜빡임 (둘 다)
# %s=Yname2(obj)
# "Your lamp crackles and flickers." → "당신의 랜턴이 탁탁거리며 깜빡였다."
#, c-format
msgctxt "lantern"
msgid "%s crackles and flickers."
msgstr "%s{이/가} 탁탁거리며 깜빡였다."

# apply.c:1555 — 랜턴이 탁탁거림 (소리만)
# %s=Yname2(obj)
# "Your lamp crackles." → "당신의 랜턴이 탁탁거렸다."
#, c-format
msgctxt "lantern"
msgid "%s crackles."
msgstr "%s{이/가} 탁탁거렸다."

# apply.c:1555 — 랜턴이 깜빡임 (시각만)
# %s=Yname2(obj)
# "Your lamp flickers." → "당신의 랜턴이 깜빡였다."
#, c-format
msgctxt "lantern"
msgid "%s flickers."
msgstr "%s{이/가} 깜빡였다."

# [FIX] muse.c:297 — 몬스터 물약 음용
# %1$s = Monnam(mtmp), %2$s = singular(otmp, doname) (물약 이름)
# 영어: "The orc drinks a potion of healing!"
# 기존 오역: "%s{이/가} %s!" (동사 누락)
#, c-format
msgid "%s drinks %s!"
msgstr "%s{이/가} %s{을/를} 마셨다!"

# [FIX] dokick.c:309 — 금화 던지기 빗맞힘
# %1$s = xname(gold), %2$s = otense("hit") (맞혔다), %3$s = mon_nam
# 영어: "The gold piece harmlessly hits the orc."
# 기존 오역: "%s{이/가} 해를 끼치지 않고 %s %s." (SVO 어순)
#, c-format
msgid "%s harmlessly %s %s."
msgstr "%1$s{이/가} %3$s{을/를} 해를 끼치지 않고 맞혔다.%2$.0s"

# [FIX] zap.c:4798 — 삼켜진 상태에서 빔 공격
# %1$s = The(flash_str), %2$s = mon_nam, %3$s = exclam ("!"/".")
# 영어: "The bolt of fire rips into the purple worm!"
# 기존 오역: "%s{이/가} %s%s{을/를} 찢는다" ({을/를}이 느낌표에 붙음)
#, c-format
msgid "%s rips into %s%s"
msgstr "%1$s{이/가} %2$s{을/를} 찢었다%3$s"

# [FIX] read.c:1895 — 바위 눈사태 (지구의 두루마리)
# %1$s = avalanche/avalanches 이름, %2$s = vtense("materialize"), %3$s = "around"/"above"
# 영어: "An avalanche of boulders materializes above you!"
# 기존 오역: "바위들의 %s{이/가} %s %s{을/를}!" (문장 부서짐)
#, c-format
msgid "%s of boulders %s %s you!"
msgstr "바위들의 %1$s{이/가} 당신 %3$s %2$s!"

# [FIX] pray.c:1409 — 제단에서 물약 축복/저주
# %1$s = "The"/"Some of the"/"One of the", %2$s = "s"/"" (복수형)
# %3$s = "s"/"" (동사접미), %4$s = hcolor (색상)
# 영어: "The potion on the altar glows blue for a moment."
# 기존 오역: "제단의 %s 물약%s{이/가} 잠시 %s %s 빛난다." (%3 동사접미 미억제)
# 주의: %1$s "그"/"일부의"/"중 하나의" 매핑이 어색 (Known Issue)
#, c-format
msgid "%s potion%s on the altar glow%s %s for a moment."
msgstr "제단의 %1$s 물약%2$.0s{이/가} 잠시 %4$s 빛을 발했다.%3$.0s"

# [FIX] wield.c:766 — 이중무기 부적합 무기
# %1$s = Yname2(otmp), %2$s = "aren't"/"isn't a", %3$s = "primary"/"secondary"
# %4$s = plur (복수접미 "s"/"")
# 영어: "Your sword isn't a suitable primary weapon."
# 기존 오역: "%s{이/가} 적합한 %s 무기%s %s." (aren't/plur 미처리)
#, c-format
msgid "%s %s suitable %s weapon%s."
msgstr "%1$s{은/는} 적합한 %3$s 무기가 아니다.%2$.0s%4$.0s"

# [FIX] pray.c:802 — 발 앞에 나타남 (신의 선물)
# %1$s = item/Something, %2$s = "land"/"appear" (착지했다/나타난다)
# %3$s = "beneath"/"at" (아래에/근처에), %4$s = feet (발)
# 영어: "A long sword appears at your feet!"
# 기존 오역: "%s{이/가} 당신의 %s{을/를} %s %s!" (인수 매핑 잘못)
#, c-format
msgid "%s %s %s your %s!"
msgstr "%1$s{이/가} 당신의 %4$s %3$s %2$s!"

# [FIX] dothrow.c:1285 — 천장에 맞고 떨어짐
# %1$s = Doname2(obj), %2$s = "hits"/"almost hits" (맞혔다/거의 맞을 뻔했다)
# %3$s = ceiling (천장), %4$s = body_part(HEAD) (머리)
# 영어: "The rock hits the ceiling, then falls back on top of your head."
# 기존 오역: "%s{이/가} %s %s{을/를} 맞고 %s 위로 떨어졌다." (동사 위치 혼란)
#, c-format
msgid "%s %s the %s, then falls back on top of your %s."
msgstr "%1$s{이/가} %3$s{을/를} %2$s, 그리고 %4$s 위로 떨어졌다."

# [FIX] dothrow.c:2643 — 물약/유리 파손
# %1$s = Doname2(obj), %2$s = "s"/"" (복수접미), %3$s = ""/" into a thousand pieces"
# 영어: "The potion shatters into a thousand pieces!"
# 기존 오역: "%s{이/가} 산산조각%s%s!" (산산조각 이중, 복수접미 미억제)
# "산산조각났다"가 이미 "into a thousand pieces" 의미 포함 → %2,%3 억제
#, c-format
msgid "%s shatter%s%s!"
msgstr "%1$s{이/가} 산산조각났다!%2$.0s%3$.0s"

# [FIX] zap.c:3956 — 물 위의 몬스터 통과
# %1$s = Yname2(obj), %2$s = otense("pass") (지나갔다), %3$s = mon_nam
# 영어: "The dart passes over the water moccasin."
# 기존 오역: "%s{이/가} %s 위로 %s." (SVO 어순)
#, c-format
msgid "%s %s over %s."
msgstr "%1$s{이/가} %3$s 위로 %2$s."

# [FIX] uhitm.c:1288 — 물 튀기기 공격
# %1$s = what (액체), %2$s = vtense("splash") (튀다), %3$s = whom (대상 부위)
# 영어: "The water splashes over the orc's face!"
# 기존 오역: "%s{이/가} %s 위로 %s!" (SVO 어순)
#, c-format
msgid "%s %s over %s!"
msgstr "%1$s{이/가} %3$s 위로 %2$s!"

