msgstr "변했다"

# potion.c:2519 - 물약 혼합 동사
# "mix" = 자동사 "섞이다" (X mixes with Y), ko.po "섞다"는 타동사
msgid "mix"
msgstr "섞인다"

# potion.c:2657 - 기름으로 녹/부식 제거 시 상태 서술
# ko.po "부식된 "은 "rusty" 부분 누락 + 뒤 공백
msgid "corroded and rusty"
msgstr "부식되고 녹슨"

# --- 조합 포맷 오버라이드 ---

# potion.c:2518 - 물약끼리 혼합
# %1$s=qbuf("그"/"2개의"), %2$s=물약이름, %3$s="mix"→"섞인다"
# %4$s="하나의 "/""(빈문자열), %5$s=대상 물약이름
# 영어 조합: "The potions of healing mix with one of the potion of speed..."
# 한국어 조합: "그 치료의 물약이 하나의 신속의 물약과 섞인다..."
# 주의: 영어 SVO→한국어 SOV 어순 변경, 위치 지정자 필수
#, c-format
msgid "%s %s %s with %s%s..."
msgstr "%1$s %2$s{이/가} %4$s%5$s{과/와} %3$s..."

# potion.c:2649 - 기름 물약에 무기 담그기 (시각 효과)
# %1$s=Yname2(obj) 아이템이름, %2$s="gleam"→"빛나" (어간, 억제)
# 영어 조합: "Your long sword gleams with an oily sheen."
# 한국어 조합: "당신의 장검이 기름기 있는 광택을 띤다."
# 주의: %2$s 동사 어간이 한국어 포맷에 안 맞으므로 억제
#, c-format
msgid "%s %s with an oily sheen."
msgstr "%1$s{이/가} 기름기 있는 광택을 띤다.%2$.0s"

# potion.c:2652 - 기름 물약에 무기 담그기 (장님 효과)
# %1$s=Yname2(obj) 아이템이름, %2$s="feel"→"느껴진다" (억제)
# 런타임: "당신의 장검이 기름진 느낌이다." (feel/are 양쪽 %.0s로 억제)
#, c-format
msgid "%s %s oily."
msgstr "%1$s{이/가} 기름진 느낌이다.%2$.0s"

# potion.c:2654 - 기름으로 녹/부식 제거 결과
# %1$s=Yname2(obj), %2$s="are"/"feel"→억제, %3$s="녹슨"/"부식된"/"부식되고 녹슨"
# 런타임: "당신의 장검이 덜 녹슨 것 같다." (feel/are 양쪽 %.0s로 억제)
#, c-format
msgid "%s %s less %s."
msgstr "%1$s{이/가} 덜 %3$s 것 같다.%2$.0s"

# --- 혼합물 결과 포맷 ---

# potion.c:2563 - 물약 혼합 결과: 거품
# %s = ", then clears" → ", 그리고 맑아졌다" (Not blind) / "" (Blind)
# 영어 조합: "The mixture bubbles, then clears."
# 한국어 조합: "혼합물이 거품을 낸다, 그리고 맑아졌다."
# 주의: 영어는 %s가 동사 뒤(bubbles%s), 한국어도 동사 뒤로 배치
#, c-format
msgid "mixture bubbles%s."
msgstr "혼합물이 거품을 낸다%s."

# --- 시금석 조합 포맷 ---

# apply.c:2799 - 시금석에 물건 문지르기 (긁힌 자국)
# %1$s=streak_color ("노란색"/빈문자열), %2$s=" "/"" (공백), %3$s=stonebuf ("돌")
# 영어 조합: "You make yellow scratch marks on the touchstone."
# 한국어 조합: "돌에 노란색 긁힌 자국을 냈다."
# 주의: 영어 %1%2%3 순서 → 한국어 %3%1%2 순서 (돌에 + 색 + 자국)
#, c-format
msgid "make %s%sscratch marks on the %s."
msgstr "%3$s에 %1$s%2$s긁힌 자국을 냈다."

# apply.c:2803 - 시금석에 물건 문지르기 (줄무늬 보임)
# %1$s=streak_color ("노란색"), %2$s=stonebuf ("돌")
# 영어 조합: "You see yellow streaks on the stone."
# 한국어 조합: "돌에 노란색 줄무늬가 보인다." (You_see는 한국어에서 접두사 없음)
#, c-format
msgid "%s streaks on the %s."
msgstr "%2$s에 %1$s 줄무늬가 보인다."

