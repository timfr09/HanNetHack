  <!-- Paths match sys/windows/GNUmakefile $(LUASRC) when Lua lives under lib/lua-$(LUA_VERSION),
       so MSVC and MinGW builds can alternate without rewriting this header. -->
  <Target Name="GenerateHeader" BeforeTargets="ClCompile" Outputs="$(IncDir)\nhlua.h">
    <Message Text="Generating $(IncDir)nhlua.h" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$lines = @('/* nhlua.h - generated by nhlua_h.vcxproj ClCompile */', '#include &lt;lua.h&gt;', 'ATTRNORETURN LUA_API int (lua_error) (lua_State *L) NORETURN;', '#include &lt;lualib.h&gt;', '#include &lt;lauxlib.h&gt;', '/*nhlua.h*/'); [IO.File]::WriteAllLines('$(IncDir)\nhlua.h', $lines, [Text.Encoding]::ASCII)&quot;" />
  </Target>
