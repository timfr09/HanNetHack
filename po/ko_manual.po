# ============================================================
# insight.c:737-751 - 체력/에너지 포인트 표시 (서술어 보완)
# ============================================================
# you_have()의 "have" → "​"(제로 폭 스페이스)로 동사가 사라지므로,
# 내용 문자열에 "있다"/"없다" 서술어를 포함해야 자연스러운 한국어가 됨.

# 체력 전부 있음 (hp == hpmax && hpmax > 1)
# 영어: "You have all 42 hit points."
# 한국어: "당신은 42 체력 전부 있다."
#, c-format
msgctxt "hp_all"
msgid "all %d hit points"
msgstr "%d 체력 전부 있다"

# 체력 일부 (hp != hpmax 또는 hpmax <= 1)
# 영어: "You have 10 out of 42 hit points."
# 한국어: "당신은 10/42 체력이 있다."
# %3$.0s로 plur() 결과(""/"s")를 억제
#, c-format
msgctxt "hp_partial"
msgid "%d out of %d hit point%s"
msgstr "%1$d/%2$d 체력이 있다%3$.0s"

# 에너지 없음 (pwmax == 0)
# 영어: "You have no energy points (spell power)."
# 한국어: "당신은 에너지 포인트 (주문력) 없다."
#, c-format
msgctxt "energy_none"
msgid "no %s"
msgstr "%s 없다"

# 에너지 둘 다 (pwmax == 2, 전부 보유)
# 영어: "You have both energy points (spell power)."
# 한국어: "당신은 에너지 포인트 (주문력) 둘 다 있다."
#, c-format
msgctxt "energy_both"
msgid "both %s"
msgstr "%s 둘 다 있다"

# 에너지 전부 (pw == pwmax, pwmax > 2)
# 영어: "You have all 42 energy points (spell power)."
# 한국어: "당신은 에너지 포인트 (주문력) 42 전부 있다."
#, c-format
msgctxt "energy_all"
msgid "all %d %s"
msgstr "%2$s %1$d 전부 있다"

# 에너지 일부 (pw != pwmax)
# 영어: "You have 10 out of 42 energy points (spell power)."
# 한국어: "당신은 에너지 포인트 (주문력) 10/42 있다."
#, c-format
msgctxt "energy_partial"
msgid "%d out of %d %s"
msgstr "%3$s %1$d/%2$d 있다"

